# Port for the server
PORT=5050

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=dermalyze

# Database URL (used on Railway — takes precedence over MYSQL_* vars if set)
DATABASE_URL=mysql://user:password@host:port/database

# JWT Secrets for Authentication
# IMPORTANT: JWT_SECRET and JWT_REFRESH_SECRET must be different long random strings
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_separate_refresh_secret_here_min_32_chars

# Hugging Face API Token (for skin analysis)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upstash Redis (for caching — optional, falls back to in-memory if not set)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Firebase Cloud Messaging (for push notifications — optional)
# Set FIREBASE_SERVICE_ACCOUNT as a single-line JSON string (escape quotes)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Deployment Environment
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration (Resend API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Dermalyze <onboarding@resend.dev>

# Admin Configuration (for doctor verification alerts and seeding)
ADMIN_EMAIL=admin@dermalyze.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
